---
import ProfileSection from '../../components/story/ProfileSection.jsx';
import Footer from '../../components/story/Footer.jsx';
import { team } from '../../data/team.js';
import '../../styles/tokens.css';
import '../../styles/hero.css';
import '../../styles/story.css';

export function getStaticPaths() {
  return team.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{person.profileName} | Amandus Procurement Group</title>
    <meta name="description" content={`Meet ${person.profileName} of Amandus Procurement Group.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/" aria-label="Amandus, back to home"><img src="/images/amandus-mark.svg" alt="" /><span>Amandus</span></a>
      <a class="header-cta profile-header-cta" href="/#contact">Request Call</a>
    </header>
    <main class="site-main profile-page">
      <ProfileSection person={person} />
    </main>
    <Footer />
    <script>
      const backLink = document.querySelector('[data-back-to-team]');
      backLink?.addEventListener('click', (event) => {
        if (!document.referrer) return;
        const previous = new URL(document.referrer);
        if (previous.origin !== window.location.origin || !['/', '/index.html'].includes(previous.pathname)) return;
        event.preventDefault();
        window.history.back();
      });
    </script>
  </body>
</html>
